Windows Registry Editor Version 5.00

[HKEY_CLASSES_ROOT\Directory\Background\shell\Open Terminal Here Admin]
@="Open Terminal Here (Admin)"
"Icon"="wt.exe"

[HKEY_CLASSES_ROOT\Directory\Background\shell\Open Terminal Here Admin\command]
@="cmd /c echo|set/p=\"%V\"|powershell -NoP -W 1 -NonI -NoL \"Start-Process -FilePath 'wt.exe' -ArgumentList '-d',$Input -Verb RunAs\""
